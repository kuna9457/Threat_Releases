# Threat Intelligence API Keys (optional for mock mode)
# VIRUSTOTAL_API_KEY accepts one key, or several comma-separated keys to
# round-robin across — each key gets its own 4/min bucket, so N keys give
# roughly N x VIRUSTOTAL_RPM effective throughput on large batches.
# e.g. VIRUSTOTAL_API_KEY=key_one,key_two,key_three
VIRUSTOTAL_API_KEY=your_virustotal_key_here
GOOGLE_SAFE_BROWSING_API_KEY=your_google_key_here
# ABUSEIPDB_API_KEY also accepts several comma-separated keys (each free key = 1000 checks/day).
# e.g. ABUSEIPDB_API_KEY=key_one,key_two,key_three
ABUSEIPDB_API_KEY=your_abuseipdb_key_here
URLSCAN_API_KEY=your_urlscan_key_here
URLHAUS_API_KEY=your_urlhaus_key_here

# Per-vendor rate limits (requests/minute) — raise if any key above is on a paid tier.
VIRUSTOTAL_RPM=4
ABUSEIPDB_RPM=30
URLSCAN_RPM=30
